<?php

/**
 * CLI entry point — the counterpart to public/index.php for workers, cron and
 * one-off commands. Runs in the phpcli container: `make console ARGS=...`.
 *
 * Same kernel, same cascade, no request context: max_execution_time is 0 in
 * the cli image, so a long-running consumer is not cut off.
 */

declare(strict_types=1);

use App\BuildHttpApp;
use App\Console\DbImport;
use App\Console\SystemRun;
use JardisCore\Kernel\Bootstrap\BuildDomainKernelFromEnv;

require dirname(__DIR__) . '/vendor/autoload.php';

$root = dirname(__DIR__);
$bootstrap = $root . '/src/App/bootstrap.php';
$command = $argv[1] ?? 'list';

// `system` builds the whole application itself (App\BuildHttpApp, the one place
// shared with public/index.php) — it must not boot the kernel a second time
// here. Arguments and src/Api/*/system.php are checked before anything boots.
// Logic and exit codes: App\Console\SystemRun.
if ($command === 'system') {
    exit((new SystemRun())($root, array_slice($argv, 2), static fn (): array => (new BuildHttpApp())($root)));
}

$app = is_file($bootstrap)
    ? require $bootstrap
    : ['kernel' => (new BuildDomainKernelFromEnv())($root)];

$kernel = $app['kernel'];

switch ($command) {
    case 'list':
        echo "Available commands:\n";
        echo "  list      this overview\n";
        echo "  kernel    which services the kernel resolved\n";
        echo "  db:import [file]   no file: set up the whole database (package SQL, then all BC schemas);\n";
        echo "                     file: run one SQL schema file (path relative to the project root)\n";
        echo "  system <tenant> <METHOD> <path> [body]\n";
        echo "            one door call as the system user (src/Api/*/system.php, ENV SYSTEM_SIGN_IN_SECRET);\n";
        echo "            prints status and body, exit 1 on a refused run or a status of 400 and above\n";
        exit(0);

    case 'kernel':
        // Every adapter is optional and degrades to null. This shows what is
        // actually wired, which is the fastest way to tell a missing ENV from
        // a missing package.
        foreach (['dbConnection', 'cache', 'logger', 'mailer', 'httpClient', 'filesystem', 'messaging'] as $service) {
            $resolved = $kernel->{$service}() !== null ? 'yes' : 'no';
            printf("  %-12s %s\n", $service, $resolved);
        }
        exit(0);

    case 'db:import':
        // Schema over the kernel's own connection — no DB client binary, no
        // second connection config. Logic and exit codes: App\Console\DbImport.
        $file = $argv[2] ?? '';
        exit((new DbImport())($root, $file, $kernel->dbConnection()));

    default:
        fwrite(STDERR, sprintf("Unknown command '%s'. Try 'list'.\n", $command));
        exit(1);
}

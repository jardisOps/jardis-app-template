# =============================================================================
# jardis-app-template — project configuration: ONE file, in the project ROOT
# =============================================================================
# `make` copies this file to `.env` the first time it is needed; `.env` is
# gitignored, this example is versioned. Edit `.env` directly — there is no
# overlay layer: no `.env.local`, no `.env.{APP_ENV}`. One file, no overlays.
# The guardrail (support/check-env-secrets.sh) rejects such files on purpose.
#
# Three readers share this one file:
#   docker compose  — interpolates ${KEY} in support/docker-compose.yml
#   make            — `include .env` in the Makefile
#   the Jardis kernel — DotEnv::loadPrivate(<projectRoot>) inside the container
# The process environment ALWAYS wins over this file (jardissupport/dotenv
# >= 1.4.0, 12-factor III): a container can run with no `.env` at all.
#
# THE READER NAMES THE KEY, THE TEMPLATE MIRRORS IT. No key is invented here:
# the kernel blocks come from jardiscore/kernel `docs/.env.example`, the PHP
# and nginx keys from devops/php-image-builder. Renaming one here would only
# detach it from the code that reads it.
#
# BLOCK CONTRACT — the tooling (bin/sync-env-from-kernel.sh, Jardis Builder)
# reads this file blockwise. Every `KEY=value` line sits under exactly one
# `# === <block> ===` header. `stack` and `nginx` are this template's own
# blocks; the other eight are the kernel's contract and MUST stay named
#   app | database | redis | cache | logger | http | mail | messaging
#
# SECRETS: values consumed by docker compose (see the `${KEY}` references in
# support/docker-compose.yml) must stay PLAINTEXT — compose cannot decrypt.
# Only kernel-read keys may carry `secret(...)`; `make encrypt` produces it.
# =============================================================================


# === stack ===
# -----------------------------------------------------------------------------
# Read by docker compose and by the Makefile — never by the application.
# -----------------------------------------------------------------------------

# --- Docker ---
DOCKER_HUB=headgent
COMPOSE_FILE=support/docker-compose.yml
COMPOSE_PROJECT_NAME=jardis-app

# --- Services (the one switch) ---
# Comma-separated list of opt-in services, read natively by docker compose.
# Empty = web + app only (SQLite, no further container). This line is the
# machine-writable interface for stack configuration — tools set values here,
# never in the compose file.
#
#   db-mariadb | db-postgres   pick ONE — both answer on the hostname "db"
#   cache                      Redis
#   rabbitmq                   AMQP broker + management UI
#   kafka                      single-node KRaft broker
#   mail                       Mailpit (SMTP catcher + web UI)
#   worker                     supervised bin/console process (WORKER_COMMAND)
#
# Example: COMPOSE_PROFILES=db-mariadb,cache,mail
COMPOSE_PROFILES=

# --- Images ---
# The PHP runtimes come from devops/php-image-builder. Pin the immutable
# <version>-<date> tag in real projects; the plain version tag moves.
PHP_VERSION=8.3
PHP_IMAGE_CLI=phpcli
PHP_IMAGE_FPM=phpfpm
NGINX_VERSION=1.28
MARIADB_VERSION=11.8
POSTGRES_VERSION=18
RABBITMQ_VERSION=4.3
KAFKA_VERSION=4.3.1
MAILPIT_VERSION=v1.31

# --- HTTP ---
HTTP_PORT=8080
MAILPIT_UI_PORT=8025
RABBITMQ_UI_PORT=15672

# --- PHP runtime (read by the image entrypoint, see APP_ENV in the app block) ---
# The explicit values below match the images' dev profile and act as
# stack-level overrides. Do NOT blank them instead of changing them: the
# compose file substitutes its own defaults for empty values.
PHP_MEMORY_LIMIT=512M
PHP_TIMEZONE=UTC
PHP_LOG_ERRORS=On
APCU_SHM_SIZE=64M
OPCACHE_MEMORY_CONSUMPTION=128
OPCACHE_MAX_ACCELERATED_FILES=4000

# Profile-driven (see APP_ENV in the app block)
PHP_ERROR_REPORTING=E_ALL
PHP_DISPLAY_ERRORS=On
OPCACHE_REVALIDATE_FREQ=0

# JIT stays off while Xdebug is on, and the buffer has to go to 0 WITH it —
# a 128M buffer next to Xdebug makes PHP warn twice per call. The image
# entrypoint gets this right on its own (measured: dev profile = jit off,
# buffer 0); the explicit pair stays because these env values override the
# profile, and the compose defaults are the prod-leaning ones.
OPCACHE_JIT=off
OPCACHE_JIT_BUFFER_SIZE=0

# --- Xdebug ---
# No port mapping is needed: Xdebug connects OUTWARD to the IDE on
# XDEBUG_CLIENT_HOST, it does not listen inside the container.
XDEBUG_MODE=debug
XDEBUG_START_WITH_REQUEST=yes
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003
XDEBUG_LOG_LEVEL=0

# --- PCOV (code coverage) ---
PCOV_ENABLED=0

# --- Worker (profile: worker) ---
# The command the supervised worker container runs via bin/console. The
# default only lists commands and exits — set a real long-running consumer
# before activating the profile.
WORKER_COMMAND=list


# === nginx ===
# -----------------------------------------------------------------------------
# Template variables of support/nginx/templates/default.conf.template, mirrored
# from devops/php-image-builder `src/shared/nginx/nginx-defaults.env` (that file
# documents each one). The official nginx image renders the template via
# envsubst at start; compose passes these keys in as `environment:` entries.
# envsubst has no defaults and no validation — every variable the template
# uses must be set here, or nginx fails to start.
#
# NGINX_VERSION (the image tag) is NOT one of them: it is a stack key and
# lives in the stack block above.
# -----------------------------------------------------------------------------

# server_name of the vhost.
NGINX_HOST=localhost

# Application root in the container and the document root beneath it. The
# template combines both: root ${NGINX_APP_ROOT}${NGINX_DOCUMENT_ROOT} —
# NGINX_DOCUMENT_ROOT therefore starts with a slash. NGINX_APP_ROOT matches
# the image's APP_ROOT so nginx and the PHP containers see the same path.
NGINX_APP_ROOT=/app
NGINX_DOCUMENT_ROOT=/public

# Front controller. Drives index, try_files and the PATH_INFO location.
NGINX_INDEX_FILE=index.php

# FastCGI upstream: service name of the php-fpm container and its port. The
# fpm service in support/docker-compose.yml is called "app".
NGINX_FASTCGI_UPSTREAM=app
NGINX_PHP_PORT=9000

# Maximum request size.
NGINX_CLIENT_MAX_BODY_SIZE=100m

# FastCGI timeouts in seconds. READ covers the runtime of the PHP request and
# should be generous alongside PHP_MAX_EXECUTION_TIME_WEB; CONNECT only
# concerns establishing the connection to the upstream.
NGINX_FASTCGI_READ_TIMEOUT=600
NGINX_FASTCGI_SEND_TIMEOUT=600
NGINX_FASTCGI_CONNECT_TIMEOUT=300

# Scheme under which the application is reachable from outside: http or https.
# The one switch sets the fastcgi parameters HTTPS, REQUEST_SCHEME and
# HTTP_X_FORWARDED_PROTO together (their CGI names stay unprefixed).
#
#   http   No upstream TLS proxy. HTTPS is not passed through, the application
#          builds http URLs. The right default for the demo stack and local
#          development.
#   https  Behind a TLS proxy (Traefik, nginx-proxy, ALB) that terminates TLS
#          and forwards to this vhost in plaintext.
NGINX_REQUEST_SCHEME=http


# === app ===
# -----------------------------------------------------------------------------
# APP_ENV selects the dev/test/prod profile of the php-image-builder images
# (dev = Xdebug on, JIT off, display_errors on; prod = the reverse). It is
# active here because three readers need it: the image entrypoint, the
# Makefile and the kernel. In production, set it in the process environment
# instead, so one image can serve every stage without a file change.
APP_ENV=dev
#
# APP_SECRET_KEY is the master key for `secret(...)` values. It belongs in the
# PROCESS ENVIRONMENT ONLY — never in this file. A key written here would have
# to be read by the very load it is supposed to unlock, and it would sit in
# the kernel's `$env` array in plaintext. Without it, the kernel falls back to
# `<projectRoot>/support/secret.key`; with neither, an encrypted value aborts
# the boot instead of being passed on as a cipher.
# APP_SECRET_KEY=<base64 32-byte key> — process environment only, never in this file


# === database ===
# -----------------------------------------------------------------------------
# BuildConnectionFromEnv. Driver: mysql (default) | pgsql | sqlite.
# DB_HOST unset or empty -> no connection at all, no error.
#
# Delivery state: SQLite in var/, so the template runs with no db container.
# Activate a db profile in COMPOSE_PROFILES, then swap the two blocks below.
# -----------------------------------------------------------------------------
DB_DRIVER=sqlite
DB_PATH=/app/var/app.sqlite

# --- MySQL / MariaDB (profile db-mariadb; host "db" is the network alias) ----
#DB_DRIVER=mysql
#DB_HOST=db
#DB_PORT=3306
#DB_CHARSET=utf8mb4

# --- PostgreSQL (profile db-postgres) ----------------------------------------
#DB_DRIVER=pgsql
#DB_PORT=5432

# Credentials of the db container: read by the kernel AND by compose, so they
# stay active and in PLAINTEXT — compose cannot resolve `secret(...)`.
# A `# Template:` line marks a key this template consumes itself; the parity
# check treats such an extra as known instead of reporting it.
# Template: read by compose (MARIADB_USER / POSTGRES_USER).
DB_USER=app
# Template: read by compose (MARIADB_PASSWORD / POSTGRES_PASSWORD).
DB_PASSWORD=app
# Template: read by compose (MARIADB_DATABASE / POSTGRES_DB).
DB_DATABASE=app

# MariaDB only, no kernel reader at all.
# Template: read by compose (MARIADB_ROOT_PASSWORD).
DB_ROOT_PASSWORD=app-root

# --- Read replicas (optional; the pool needs jardisadapter/dbconnection —
# without the adapter a single plain PDO on DB_HOST is used) -------------------
#DB_READER1_HOST=replica1.internal
#DB_READER1_PORT=3306
#DB_READER1_USER=root
#DB_READER1_PASSWORD=
#DB_READER1_DATABASE=app
#DB_READER2_HOST=replica2.internal

# --- Pool tuning (optional, only read when a ConnectionPool is built — i.e.
# at least one DB_READER{N}_HOST plus jardisadapter/dbconnection installed).
# Setting NONE keeps the adapter's ConnectionPoolConfig defaults; setting ANY
# builds an explicit config where only the set keys deviate.
# DB_POOL_STICKY_WRITER requires jardisadapter/dbconnection >= 1.1.0 — on
# older versions the pool build fails and the fallback to a plain PDO on
# DB_HOST applies (with an error_log notice). ------------------------------
#DB_POOL_VALIDATE_CONNECTIONS=true
#DB_POOL_HEALTH_CHECK_CACHE_TTL=30
#DB_POOL_HEALTH_CHECK_NEGATIVE_CACHE_TTL=0
#DB_POOL_LOAD_BALANCING_STRATEGY=round-robin
#DB_POOL_STICKY_WRITER=false


# === redis ===
# -----------------------------------------------------------------------------
# BuildRedisFromEnv (D4 fan-out): ONE Redis connection, built once, feeds BOTH
# the cache "redis" layer and the logger "redis" handler. There is no
# per-consumer Redis config — set it once, here. The `redis` messaging
# transport reads the same keys but opens its OWN connection (a blocking
# consume() would starve cache and logger otherwise).
#
# The host is the compose service name of the `cache` profile.
# -----------------------------------------------------------------------------
#REDIS_HOST=cache
#REDIS_PORT=6379
#REDIS_PASSWORD=
#REDIS_DATABASE=0


# === cache ===
# -----------------------------------------------------------------------------
# BuildCacheFromEnv (requires jardisadapter/cache). Comma-separated layer
# list, tried in this order (write-through, first hit wins):
#   memory | apcu | redis | db
# `redis` needs the redis block; `db` needs an active database connection.
# -----------------------------------------------------------------------------
#CACHE_LAYERS=memory,redis
#CACHE_NAMESPACE=app

# db layer table name (defaults to "cache" if unset)
#CACHE_DB_TABLE=cache


# === logger ===
# -----------------------------------------------------------------------------
# BuildLoggerFromEnv (requires jardisadapter/logger). Comma-separated
# handler[:LEVEL] list; LEVEL defaults to LOG_LEVEL when omitted.
# Handler types: file | console | errorlog | syslog | browserconsole | redis
#                slack | teams | loki | webhook | null
# `redis` needs the redis block (shared fan-out, D4).
# -----------------------------------------------------------------------------
#LOG_HANDLERS=console:DEBUG,file:ERROR
#LOG_CONTEXT=app
#LOG_LEVEL=INFO
#LOG_FILE_PATH=/app/var/log/app.log

# --- network handlers (URL unset -> handler skipped, no error) ---------------
#LOG_SLACK_URL=
#LOG_TEAMS_URL=
#LOG_LOKI_URL=
#LOG_WEBHOOK_URL=


# === http ===
# -----------------------------------------------------------------------------
# BuildHttpClientFromEnv (requires jardisadapter/http). Every value is
# optional — the client works with zero config once the adapter is installed.
# (HTTP_PORT is NOT one of these: it is the published stack port and lives in
# the stack block.)
# -----------------------------------------------------------------------------
#HTTP_BASE_URL=
#HTTP_TIMEOUT=30
#HTTP_CONNECT_TIMEOUT=10
#HTTP_VERIFY_SSL=true
#HTTP_BEARER_TOKEN=
#HTTP_BASIC_USER=
#HTTP_BASIC_PASSWORD=
#HTTP_MAX_RETRIES=0
#HTTP_RETRY_DELAY_MS=100


# === mail ===
# -----------------------------------------------------------------------------
# BuildMailerFromEnv (requires jardisadapter/mailer).
# MAIL_HOST unset -> mailer stays null, no error. The host is the compose
# service name of the `mail` profile (Mailpit, SMTP on mail:1025).
# -----------------------------------------------------------------------------
#MAIL_HOST=mail
#MAIL_PORT=1025
#MAIL_ENCRYPTION=
#MAIL_USERNAME=
#MAIL_PASSWORD=
#MAIL_TIMEOUT=30
#MAIL_FROM_ADDRESS=dev@localhost
#MAIL_FROM_NAME=App


# === messaging ===
# -----------------------------------------------------------------------------
# BuildMessagingFromEnv (requires jardisadapter/messaging).
# MESSAGING_TRANSPORT selects exactly one of kafka | rabbitmq | redis |
# database. Unset or empty => no messaging service at all
# (DomainKernel::messaging() = null). An unrecognized value throws
# InvalidEnvConfigurationException — pick one of the four, don't guess a fifth.
# -----------------------------------------------------------------------------
#MESSAGING_TRANSPORT=

# --- kafka (profile: kafka) ---------------------------------------------------
# KAFKA_BROKERS is the FULL broker list, comma-separated "host:port" pairs.
# There is no separate KAFKA_PORT key — a port alone is meaningless once a
# multi-broker list is in play. Kafka CONSUMING is not available through
# DomainKernel::messaging() (no consumer-group ENV key by design); publish()
# works, consume() throws and explains.
#MESSAGING_TRANSPORT=kafka
#KAFKA_BROKERS=kafka:9092
#KAFKA_USER=
#KAFKA_PASSWORD=

# --- rabbitmq (profile: rabbitmq) ---------------------------------------------
# RABBITMQ_HOST is required once MESSAGING_TRANSPORT=rabbitmq is chosen — no
# implicit "localhost" default, so a missing value is loud at boot.
# consume($topic) uses $topic itself as the queue name.
#MESSAGING_TRANSPORT=rabbitmq
#RABBITMQ_HOST=rabbitmq
#RABBITMQ_PORT=5672

# Credentials of the rabbitmq container: read by the kernel AND by compose, so
# they stay active and in PLAINTEXT — compose cannot resolve `secret(...)`.
# Template: read by compose (RABBITMQ_DEFAULT_USER).
RABBITMQ_USER=app
# Template: read by compose (RABBITMQ_DEFAULT_PASS).
RABBITMQ_PASSWORD=app

# --- redis (profile: cache) ---------------------------------------------------
# Transport `redis` reads the keys of the `redis` block above — no second set
# here. It uses Redis Streams, not Pub/Sub, so a message is persisted whether
# or not a consumer happens to be listening yet. REDIS_HOST is required once
# this transport is chosen.
#MESSAGING_TRANSPORT=redis

# --- database (no profile, no container) --------------------------------------
# The broker-less transport (Transactional Outbox): it reuses the writer PDO
# built from the database block. Choosing it without a usable database
# connection throws InvalidEnvConfigurationException at boot.
# BEFORE the first publish(): create the event tables as part of your normal
# migrations — see support/sql/domain_events.sql and the README.
#MESSAGING_TRANSPORT=database
#
# All six keys are optional; each missing one keeps the adapter's own default.
#MESSAGING_DB_TABLE=domain_events
#MESSAGING_DB_SUBSCRIPTION_TABLE=domain_event_subscriptions
# true = hard delete after processing, false = soft delete via processed_at
#MESSAGING_DB_DELETE_AFTER_PROCESSING=false
#MESSAGING_DB_POLLING_INTERVAL_MS=1000
#MESSAGING_DB_BATCH_SIZE=10
#MESSAGING_DB_MAX_ATTEMPTS=3

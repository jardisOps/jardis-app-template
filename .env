# =============================================================================
# jardis-app-template — stack configuration
# =============================================================================
# Read by docker compose and the Makefile. This file is VERSIONED on purpose:
# a template must run right after cloning, and a missing .env would break
# `make` before the first command. It therefore holds no secrets.
#
# Overriding a value locally: docker compose reads THIS file only — .env.local
# is a DotEnv convention and applies to config/env/, not here (measured).
# For the stack, put the value in the environment instead, which compose
# prefers over the file:
#
#   HTTP_PORT=8091 make start
#
# Application configuration lives elsewhere: config/env/, read by the Jardis
# DotEnv cascade inside the container. Values are passed in from here rather
# than repeated there.
# =============================================================================

# --- Docker ---
DOCKER_HUB=headgent
COMPOSE_FILE=support/docker-compose.yml
COMPOSE_PROJECT_NAME=jardis-app

# --- Images ---
# Both come from devops/docker/php-image-builder. Pin the immutable
# <version>-<date> tag in real projects; the plain version tag moves.
PHP_VERSION=8.3
PHP_IMAGE_CLI=phpcli
PHP_IMAGE_FPM=phpfpm
NGINX_VERSION=1.28
MARIADB_VERSION=11.8

# --- HTTP ---
HTTP_PORT=8080
MAILHOG_UI_PORT=8025

# --- PHP runtime ---
# APP_ENV drives the dev/test/prod profile of the NEW images (Xdebug, OPcache,
# JIT, error display). The published images do not carry it yet — that push is
# still blocked — so the profile-driven values below stay set explicitly and
# win over the profile either way. Once the new images are published, the
# XDEBUG_MODE/OPCACHE_*/PHP_DISPLAY_ERRORS lines can simply be emptied and
# APP_ENV takes over.
APP_ENV=dev

PHP_MEMORY_LIMIT=512M
PHP_TIMEZONE=UTC
PHP_LOG_ERRORS=On
APCU_SHM_SIZE=64M
OPCACHE_MEMORY_CONSUMPTION=128
OPCACHE_MAX_ACCELERATED_FILES=4000

# Profile-driven (see APP_ENV above)
PHP_ERROR_REPORTING=E_ALL
PHP_DISPLAY_ERRORS=On
OPCACHE_REVALIDATE_FREQ=0

# JIT stays off while Xdebug is on, and the buffer has to go to 0 WITH it.
# Measured against the currently published image: it sets opcache.jit=off by
# itself but leaves the buffer at 128M, and PHP warns twice on every single
# call over that combination. Buffer at 0 → no warning. The new images do both
# in their entrypoint, so these two lines can be emptied after that push and
# APP_ENV takes over.
OPCACHE_JIT=off
OPCACHE_JIT_BUFFER_SIZE=0

# --- Xdebug ---
# No port mapping is needed: Xdebug connects OUTWARD to the IDE on
# XDEBUG_CLIENT_HOST, it does not listen inside the container.
XDEBUG_MODE=debug
XDEBUG_START_WITH_REQUEST=yes
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003
XDEBUG_LOG_LEVEL=0

# --- PCOV (code coverage) ---
PCOV_ENABLED=0

# --- Database (profile: db) ---
# Defaults are deliberately trivial: the template ships runnable, not secure.
# Real projects override them in .env.local.
DB_NAME=app
DB_USER=app
DB_PASSWORD=app
DB_ROOT_PASSWORD=app-root

# =============================================================================
# jardis-app-template — stack configuration
# =============================================================================
# Read by docker compose and the Makefile. This file is VERSIONED on purpose:
# a template must run right after cloning, and a missing .env would break
# `make` before the first command. It therefore holds no secrets.
#
# Overriding a value locally: docker compose reads THIS file only — .env.local
# is a DotEnv convention and applies to config/env/, not here (measured).
# Override on the make command line; a plain environment variable does NOT
# survive the Makefile's `include .env` (make re-exports the file's value):
#
#   make start HTTP_PORT=8091
#
# Application configuration lives elsewhere: config/env/, read by the Jardis
# DotEnv cascade inside the container. Values are passed in from here rather
# than repeated there.
# =============================================================================

# --- Docker ---
DOCKER_HUB=headgent
COMPOSE_FILE=support/docker-compose.yml
COMPOSE_PROJECT_NAME=jardis-app

# --- Services (the one switch) ---
# Comma-separated list of opt-in services, read natively by docker compose.
# Empty = web + app only (SQLite, no further container). This line is the
# machine-writable interface for stack configuration — tools set values here,
# never in the compose file.
#
#   db-mariadb | db-postgres   pick ONE — both answer on the hostname "db"
#   cache                      Redis
#   rabbitmq                   AMQP broker + management UI
#   kafka                      single-node KRaft broker
#   mail                       Mailpit (SMTP catcher + web UI)
#   worker                     supervised bin/console process (WORKER_COMMAND)
#
# Example: COMPOSE_PROFILES=db-mariadb,cache,mail
COMPOSE_PROFILES=

# --- Images ---
# Both come from devops/php-image-builder. Pin the immutable
# <version>-<date> tag in real projects; the plain version tag moves.
PHP_VERSION=8.3
PHP_IMAGE_CLI=phpcli
PHP_IMAGE_FPM=phpfpm
NGINX_VERSION=1.28
MARIADB_VERSION=11.8
POSTGRES_VERSION=18
RABBITMQ_VERSION=4.3
KAFKA_VERSION=4.3.1
MAILPIT_VERSION=v1.31

# --- HTTP ---
HTTP_PORT=8080
MAILPIT_UI_PORT=8025
RABBITMQ_UI_PORT=15672

# --- PHP runtime ---
# APP_ENV drives the dev/test/prod profile of the images (verified on
# 8.3-20260726: dev = Xdebug on, JIT off, display_errors on; prod = the
# reverse). The explicit values below match the dev profile and act as
# stack-level overrides. Do NOT blank them instead of changing them: the
# compose file substitutes its own defaults for empty values.
APP_ENV=dev

PHP_MEMORY_LIMIT=512M
PHP_TIMEZONE=UTC
PHP_LOG_ERRORS=On
APCU_SHM_SIZE=64M
OPCACHE_MEMORY_CONSUMPTION=128
OPCACHE_MAX_ACCELERATED_FILES=4000

# Profile-driven (see APP_ENV above)
PHP_ERROR_REPORTING=E_ALL
PHP_DISPLAY_ERRORS=On
OPCACHE_REVALIDATE_FREQ=0

# JIT stays off while Xdebug is on, and the buffer has to go to 0 WITH it —
# a 128M buffer next to Xdebug makes PHP warn twice per call. The image
# entrypoint gets this right on its own (measured: dev profile = jit off,
# buffer 0); the explicit pair stays because these env values override the
# profile, and the compose defaults are the prod-leaning ones.
OPCACHE_JIT=off
OPCACHE_JIT_BUFFER_SIZE=0

# --- Xdebug ---
# No port mapping is needed: Xdebug connects OUTWARD to the IDE on
# XDEBUG_CLIENT_HOST, it does not listen inside the container.
XDEBUG_MODE=debug
XDEBUG_START_WITH_REQUEST=yes
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003
XDEBUG_LOG_LEVEL=0

# --- PCOV (code coverage) ---
PCOV_ENABLED=0

# --- Database (profiles: db-mariadb / db-postgres) ---
# Defaults are deliberately trivial: the template ships runnable, not secure.
# Real projects override them in .env.local. DB_ROOT_PASSWORD is MariaDB-only.
DB_NAME=app
DB_USER=app
DB_PASSWORD=app
DB_ROOT_PASSWORD=app-root

# --- Message broker (profile: rabbitmq) ---
RABBITMQ_USER=app
RABBITMQ_PASSWORD=app

# --- Worker (profile: worker) ---
# The command the supervised worker container runs via bin/console. The
# default only lists commands and exits — set a real long-running consumer
# before activating the profile.
WORKER_COMMAND=list

# -----------------------------------------------------------------------------
# Messaging — BuildMessagingFromEnv (requires jardisadapter/messaging)
# -----------------------------------------------------------------------------
# Delivered inactive: MESSAGING_TRANSPORT unset keeps messaging() null. Pick
# exactly one transport and uncomment its block; "kafka"/"rabbitmq" need the
# matching compose profile, "redis" reuses the cache connection's REDIS_*
# values from .env.redis (one stack, one Redis), "database" needs no
# container at all — it reuses the project's own DB_* connection.
# -----------------------------------------------------------------------------

#MESSAGING_TRANSPORT=kafka
#KAFKA_BROKERS=kafka:9092
#KAFKA_USER=
#KAFKA_PASSWORD=

#MESSAGING_TRANSPORT=rabbitmq
#RABBITMQ_HOST=rabbitmq
#RABBITMQ_PORT=5672
#RABBITMQ_USER=guest
#RABBITMQ_PASSWORD=guest

#MESSAGING_TRANSPORT=redis

# database reuses the project's DB_* connection (.env.database) — no second
# DSN, no compose profile, no container. Create the event tables first (see
# README "Opt-in services" / support/sql/domain_events.sql); the kernel wires
# publisher/consumer, it does not create the schema.
#MESSAGING_TRANSPORT=database
#MESSAGING_DB_TABLE=domain_events
#MESSAGING_DB_SUBSCRIPTION_TABLE=domain_event_subscriptions
#MESSAGING_DB_DELETE_AFTER_PROCESSING=false
#MESSAGING_DB_POLLING_INTERVAL_MS=1000
#MESSAGING_DB_BATCH_SIZE=10
#MESSAGING_DB_MAX_ATTEMPTS=3

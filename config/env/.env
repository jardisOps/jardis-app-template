# =============================================================================
# Application configuration — the DotEnv cascade
# =============================================================================
# Read INSIDE the container by BuildDomainKernelFromEnv, which is pointed at
# this directory. Alongside this file, .env.local is picked up automatically
# and overrides it — that is where secrets belong, not here.
#
# load()  aborts if the file is missing.
# load?() is skipped silently.
#
# Every adapter is optional: an unset ENV means the kernel carries null for
# that service instead of failing. That is why the delivered state needs no
# container beyond PHP itself.
# =============================================================================

load(.env.database)
load?(.env.cache)
load?(.env.logger)
load?(.env.mail)
load?(.env.http)

# Development default. Set to false for anything reachable from outside: it
# controls how much detail an error response carries.
APP_DEBUG=true

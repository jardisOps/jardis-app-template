# -----------------------------------------------------------------------------
# HTTP client — BuildHttpClientFromEnv (requires jardisadapter/http)
# -----------------------------------------------------------------------------
# Unlike the other adapters there is no on/off key: the client exists as soon
# as the adapter is installed, with the defaults below. This file only tunes
# it. Auth values are secrets — put real ones in .env.local or secret(...).
# -----------------------------------------------------------------------------

#HTTP_TIMEOUT=30
#HTTP_CONNECT_TIMEOUT=10
#HTTP_BASE_URL=
#HTTP_VERIFY_SSL=true
#HTTP_MAX_RETRIES=0
#HTTP_RETRY_DELAY_MS=100
#HTTP_BEARER_TOKEN=
#HTTP_BASIC_USER=
#HTTP_BASIC_PASSWORD=

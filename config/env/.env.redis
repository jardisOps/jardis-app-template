# -----------------------------------------------------------------------------
# Redis — shared fan-out (BuildRedisFromEnv)
# -----------------------------------------------------------------------------
# One Redis connection feeds BOTH the cache "redis" layer (.env.cache) and the
# logger "redis" handler (.env.logger). "cache" is the compose service name —
# activate the cache profile in the root .env (COMPOSE_PROFILES=cache).
# -----------------------------------------------------------------------------

#REDIS_HOST=cache
#REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Database — the one file the cascade loads with load() instead of load?()
# -----------------------------------------------------------------------------
# Delivered on SQLite so a fresh clone answers without a database container.
# Switch to a database profile (COMPOSE_PROFILES=db-mariadb or db-postgres in
# the root .env) and replace the two lines below with:
#
#   DB_DRIVER=mysql     (or pgsql)
#   DB_HOST=db          (network alias — the same for both engines)
#   DB_PORT=3306        (5432 for pgsql)
#   DB_DATABASE / DB_USER / DB_PASSWORD matching DB_NAME / DB_USER /
#   DB_PASSWORD from the root .env (the key names differ on purpose - stack
#   provisioning vs. application cascade)
# -----------------------------------------------------------------------------

DB_DRIVER=sqlite
DB_PATH=/app/var/app.sqlite

# -----------------------------------------------------------------------------
# Database — the one file the cascade loads with load() instead of load?()
# -----------------------------------------------------------------------------
# Delivered on SQLite so a fresh clone answers without a database container.
# Switch to a database profile (COMPOSE_PROFILES=db-mariadb or db-postgres in
# the root .env) and replace the two lines below with:
#
#   DB_DRIVER=mysql     (or pgsql)
#   DB_HOST=db          (network alias — the same for both engines)
#   DB_PORT=3306        (5432 for pgsql)
#   DB_DATABASE / DB_USER / DB_PASSWORD matching DB_NAME / DB_USER /
#   DB_PASSWORD from the root .env (the key names differ on purpose - stack
#   provisioning vs. application cascade)
# -----------------------------------------------------------------------------

DB_DRIVER=sqlite
DB_PATH=/app/var/app.sqlite

# -----------------------------------------------------------------------------
# mysql / pgsql connection (see note above — once DB_DRIVER is switched to
# mysql or pgsql, fill in these six keys instead of the sqlite ones; values
# below match DB_NAME/DB_USER/DB_PASSWORD from the root .env).
# -----------------------------------------------------------------------------
#DB_HOST=db
#DB_PORT=3306
#DB_USER=app
#DB_PASSWORD=app
#DB_DATABASE=app
#DB_CHARSET=utf8mb4

# -----------------------------------------------------------------------------
# PostgreSQL: set DB_PORT=5432 in the line above. One key = one line in this
# file — a second DB_PORT line would be activated together with the first by
# the Jardis runtime page (keys are matched file-wide), and the last one wins.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Read replicas (optional, requires jardisadapter/dbconnection for the pool;
# without the adapter installed, a single plain PDO on DB_HOST is used).
# Presence of DB_READER{N}_HOST is what registers reader N.
# -----------------------------------------------------------------------------
#DB_READER1_HOST=replica1.internal
#DB_READER1_PORT=3306
#DB_READER1_USER=root
#DB_READER1_PASSWORD=
#DB_READER1_DATABASE=app
#DB_READER2_HOST=replica2.internal

# -----------------------------------------------------------------------------
# Pool tuning (optional, only read when a ConnectionPool is built — i.e. at
# least one DB_READER{N}_HOST plus jardisadapter/dbconnection installed).
# Setting NONE of these keeps the adapter's ConnectionPoolConfig defaults;
# setting ANY builds an explicit config where only the set keys deviate.
# DB_POOL_STICKY_WRITER requires jardisadapter/dbconnection >= 1.1.0 — on
# older versions the pool build fails and the existing fallback to a plain
# PDO on DB_HOST applies (with an error_log notice). Booleans: only the
# literal `true` is true.
# -----------------------------------------------------------------------------
#DB_POOL_VALIDATE_CONNECTIONS=true
#DB_POOL_HEALTH_CHECK_CACHE_TTL=30
#DB_POOL_HEALTH_CHECK_NEGATIVE_CACHE_TTL=0
#DB_POOL_LOAD_BALANCING_STRATEGY=round-robin
#DB_POOL_STICKY_WRITER=false

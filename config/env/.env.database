# -----------------------------------------------------------------------------
# Database — the one file the cascade loads with load() instead of load?()
# -----------------------------------------------------------------------------
# Delivered on SQLite so a fresh clone answers without a database container.
# Switch to the db profile and these three lines change:
#
#   DB_DRIVER=mysql
#   DB_HOST=db          (the compose service name)
#   DB_NAME / DB_USER / DB_PASSWORD as set in the root .env
#
# Then start with: make start-full
# -----------------------------------------------------------------------------

DB_DRIVER=sqlite
DB_PATH=/app/var/app.sqlite

# -----------------------------------------------------------------------------
# Mailer — BuildMailerFromEnv (requires jardisadapter/mailer)
# -----------------------------------------------------------------------------
# Delivered inactive: MAIL_HOST unset keeps the mailer null. "mail" is the
# Mailpit compose service (COMPOSE_PROFILES=mail); it accepts any sender,
# no auth, no encryption — its web UI shows every caught message.
# -----------------------------------------------------------------------------

#MAIL_HOST=mail
#MAIL_PORT=1025
#MAIL_ENCRYPTION=
#MAIL_FROM_ADDRESS=dev@localhost
#MAIL_FROM_NAME=App

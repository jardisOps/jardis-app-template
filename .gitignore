.DS_Store
.idea/

vendor/
tests/reports/

# The directory has to survive a clone — DB_PATH points into it and SQLite
# fails silently on a missing directory (the kernel degrades to null, which
# looks exactly like "not configured").
var/*
!var/.gitkeep

# composer.lock IS tracked: this is type "project", not a library. Derived
# projects get the exact versions this template was verified against.

*.tmp
*.cache
*.log

# ONE config file, and it is NOT versioned: `.env` is yours per checkout,
# `.env.example` is the delivered original (make copies it on first use).
# The glob also covers every overlay name this template deliberately does not
# support — check-env-secrets.sh rejects such a file outright, so nobody
# builds a second, invisible configuration layer next to the one file.
.env*
!.env.example

# Skills installed by jardis/dev-skills come from vendor/ on every composer
# install. Tracking them produces phantom diffs on each update; the same rule
# jardiscore/kernel follows. AGENTS.md stays tracked: its managed block is
# generated, but the file is part of what a clone should carry. Exception:
# devops-app-template is THIS repo's own skill source (synced into
# jardis-claude via its skills.manifest), not a vendor install.
.claude/skills/*
!.claude/skills/devops-app-template/

*.key
support/secret.key

# Local working papers (Vorhaben docs) — not part of the delivered template
/docs/

{
    "name": "jardisops/jardis-app-template",
    "description": "Docker-based project template for Jardis domains: nginx + php-fpm, generated code in src/",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-bcmath": "*",
        "ext-json": "*",
        "jardisadapter/dbconnection": "^1.3",
        "jardisadapter/filesystem": "^1.0",
        "jardisadapter/http": "^1.0",
        "jardiscore/app": "^1.6",
        "jardiscore/kernel": "^2.5",
        "jardissupport/auth": "^1.5",
        "jardissupport/contracts": "^2.9",
        "jardissupport/data": "^1.2",
        "jardissupport/dbquery": "^1.1",
        "jardissupport/dotenv": "^1.0",
        "jardissupport/repository": "^1.6",
        "jardissupport/secret": "^1.0",
        "jardissupport/validation": "^1.5",
        "jardissupport/workflow": "^1.0",
        "nyholm/psr7": "^1.8"
    },
    "require-dev": {
        "jardis/dev-skills": "^1.9",
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.0.4",
        "squizlabs/php_codesniffer": "^3.11.2"
    },
    "autoload": {
        "psr-4": {
            "": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "jardis/dev-skills": {
            "bundled-skills": true,
            "agents-md": "aggregate",
            "git-rules": "delegated"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "jardis/dev-skills": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

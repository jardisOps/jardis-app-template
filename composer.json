{
    "name": "jardisops/jardis-app-template",
    "description": "Docker-based project template for Jardis domains: nginx + php-fpm, generated code in src/",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "jardiscore/app": "^1.0",
        "jardiscore/kernel": "^2.4",
        "jardissupport/data": "^1.0",
        "jardissupport/dbquery": "^1.1",
        "jardissupport/dotenv": "^1.0",
        "jardissupport/repository": "^1.1",
        "jardissupport/secret": "^1.0",
        "jardissupport/validation": "^1.1",
        "jardissupport/workflow": "^1.0",
        "nyholm/psr7": "^1.8"
    },
    "require-dev": {
        "jardis/dev-skills": "^1.0",
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.0.4",
        "squizlabs/php_codesniffer": "^3.11.2"
    },
    "autoload": {
        "psr-4": {
            "": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "jardis/dev-skills": {
            "bundled-skills": {
                "include": [
                    "jardis-catalog",
                    "jardis-start-here",
                    "jardis-mcp-consumer",
                    "do-git-*",
                    "do-project-git-setup"
                ]
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "jardis/dev-skills": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
